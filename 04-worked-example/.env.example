# ── Application Under Test ──
APP_URL=https://your-app.com

# ── Test Credentials ──
# These are read by the QA workflow at runtime.
# Never commit the actual .env file — only this template.
TEST_USERNAME=your-username
TEST_PASSWORD=your-password

# ── Optional: Playwright Storage State ──
# STORAGE_STATE_PATH=auth/storageState.json
